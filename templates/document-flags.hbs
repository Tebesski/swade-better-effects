<section class="standard-form"><h3>{{name}}</h3>
  <div class="form-group stacked sbe-tags-field"><label for="{{inputId}}">{{localize "swade-better-effects.UI.Flags_f38d9950af"}}</label><div class="form-fields"><input id="{{inputId}}" type="text" name="tags" value="{{tags}}" {{#unless editable}}disabled{{/unless}}>
    {{#if isGear}}<select name="flagActivation" aria-label="{{localize "swade-better-effects.UI.Flagactivation_a373ed66cc"}}" {{#unless editable}}disabled{{/unless}}><option value="equipped" {{#if (eq activation "equipped")}}selected{{/if}}>{{localize "swade-better-effects.UI.Whenequipped_0a55e11457"}}</option><option value="carried" {{#if (eq activation "carried")}}selected{{/if}}>{{localize "swade-better-effects.UI.Whencarried_e24f4b1e5f"}}</option></select>{{/if}}</div>
    </div>
  {{#if editable}}<footer class="form-footer"><button type="submit">{{localize "swade-better-effects.UI.Saveflags_257be82b53"}}</button></footer>{{/if}}
</section>
