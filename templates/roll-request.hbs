<section class="standard-form">
  <div class="form-group"><label for="{{id}}-template">{{localize "swade-better-effects.UI.Savedrequest_27e539f6db"}}</label><div class="form-fields"><select id="{{id}}-template" name="template"><option value="">{{localize "swade-better-effects.UI.Newrequest_5977ded363"}}</option>{{#each templates}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select><button type="button" data-action="openLibrary" class="icon fa-solid fa-book" aria-label="{{localize "swade-better-effects.UI.OpenRollRequestslibrary_9f8a9b5327"}}" title="{{localize "swade-better-effects.UI.OpenRollRequestslibrary_9f8a9b5327"}}"></button></div></div>
  <div class="form-group"><label for="{{id}}-name">{{localize "swade-better-effects.UI.Name_dcd1d5223f"}}</label><div class="form-fields"><input id="{{id}}-name" type="text" name="name" value="{{values.name}}" placeholder="{{localize "swade-better-effects.UI.Nameforthesavedrequest_270df548b6"}}"></div></div>
  <div class="form-group"><label for="{{id}}-description">{{localize "swade-better-effects.UI.Description_526e0087cc"}}</label><div class="form-fields"><textarea id="{{id}}-description" name="description" rows="3">{{values.description}}</textarea></div></div>
  <div class="form-group"><label for="{{id}}-trait">{{localize "swade-better-effects.UI.Trait_28e3e479e0"}}</label><div class="form-fields sbe-request-trait"><input id="{{id}}-trait" type="text" name="trait" value="{{values.trait}}" list="{{id}}-traits" placeholder="{{localize "swade-better-effects.UI.Traitname_abe694caeb"}}" required>{{#if picker}}<button type="button" data-action="pickTrait"><i class="fa-solid fa-list" inert></i> {{localize "swade-better-effects.UI.Choosetrait_5e263932b5"}}</button>{{/if}}</div></div>
  <datalist id="{{id}}-traits">{{#each attributes}}<option value="{{name}}"></option>{{/each}}<option value="Untrained"></option><option value="{{untrained}}"></option></datalist>
  <div class="form-group"><label for="{{id}}-tn">{{localize "swade-better-effects.UI.TN_57adf80633"}}</label><div class="form-fields"><input id="{{id}}-tn" {{#if configuring}}type="text" placeholder="{{localize "swade-better-effects.UI.4orspirit2_221d542beb"}}"{{else}}type="number" step="any"{{/if}} name="tn" value="{{values.tn}}" required>{{#if hasTargetNumberPreview}}<output class="sbe-request-tn-preview" hidden></output>{{/if}}</div></div>
  <div class="form-group">
    <label for="{{id}}-penalty">{{localize "swade-better-effects.UI.Penalty_241c754092"}}</label>
    <div class="form-fields"><input id="{{id}}-penalty" type="number" step="1" name="penalty" value="{{values.penalty}}" placeholder="0"></div>
  </div>
  <div class="form-group"><label for="{{id}}-flags">{{localize "swade-better-effects.UI.Flags_f38d9950af"}}</label><div class="form-fields"><input id="{{id}}-flags" type="text" name="flags" value="{{values.flags}}" placeholder="{{localize "swade-better-effects.UI.firegrapple_9d0d22e4a2"}}"></div></div>
  {{#if players}}<fieldset class="sbe-request-recipients"><legend>{{localize "swade-better-effects.UI.Players_84e12ac655"}}</legend>{{#each players}}<label><input type="checkbox" name="recipient" value="{{id}}" {{#if selected}}checked{{/if}}> <span>{{name}}</span></label>{{/each}}</fieldset>{{/if}}
  <footer class="form-footer"><button type="button" data-action="saveRequest"><i class="fa-solid fa-bookmark" inert></i> {{localize "swade-better-effects.UI.Saverequest_d756eb992a"}}</button><button type="submit"><i class="fa-solid fa-dice" inert></i> {{#if configuring}}{{localize "swade-better-effects.UI.UseRequest_a8f2610dc3"}}{{else}}{{localize "swade-better-effects.UI.GenerateRequest_a63efac7d8"}}{{/if}}</button></footer>
</section>
