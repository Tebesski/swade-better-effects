<section class="standard-form">
  <div class="form-group"><label for="{{id}}-template">Saved request</label><div class="form-fields"><select id="{{id}}-template" name="template"><option value="">New request</option>{{#each templates}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select><button type="button" data-action="openLibrary" class="icon fa-solid fa-book" aria-label="Open Roll Requests library" title="Open Roll Requests library"></button></div></div>
  <div class="form-group"><label for="{{id}}-name">Name</label><div class="form-fields"><input id="{{id}}-name" type="text" name="name" value="{{values.name}}" placeholder="Name for the saved request"></div></div>
  <div class="form-group"><label for="{{id}}-trait">Trait</label><div class="form-fields sbe-request-trait"><input id="{{id}}-trait" type="text" name="trait" value="{{values.trait}}" list="{{id}}-traits" placeholder="Trait name" required>{{#if picker}}<button type="button" data-action="pickTrait"><i class="fa-solid fa-list" inert></i> Choose trait</button>{{/if}}</div></div>
  <datalist id="{{id}}-traits">{{#each attributes}}<option value="{{name}}"></option>{{/each}}<option value="Untrained"></option><option value="{{untrained}}"></option></datalist>
  <div class="form-group"><label for="{{id}}-tn">TN</label><div class="form-fields"><input id="{{id}}-tn" {{#if configuring}}type="text" placeholder="4 or @spirit/2"{{else}}type="number" step="any"{{/if}} name="tn" value="{{values.tn}}" required>{{#if hasTargetNumberPreview}}<output class="sbe-request-tn-preview" hidden></output>{{/if}}</div></div>
  <div class="form-group"><label for="{{id}}-flags">Flags</label><div class="form-fields"><input id="{{id}}-flags" type="text" name="flags" value="{{values.flags}}" list="{{id}}-flags-list" placeholder="fire, grapple"></div></div>
  <datalist class="sbe-request-flags" id="{{id}}-flags-list"></datalist>
  {{#if players}}<fieldset class="sbe-request-recipients"><legend>Players</legend>{{#each players}}<label><input type="checkbox" name="recipient" value="{{id}}" {{#if selected}}checked{{/if}}> <span>{{name}}</span></label>{{/each}}</fieldset>{{/if}}
  <footer class="form-footer"><button type="button" data-action="saveRequest"><i class="fa-solid fa-bookmark" inert></i> Save request</button><button type="submit"><i class="fa-solid fa-dice" inert></i> {{#if configuring}}Use Request{{else}}Generate Request{{/if}}</button></footer>
</section>
