<section class="standard-form">
  <p>{{localize "swade-better-effects.UI.Flagsidentifydamagetypesmaterialscreatures_f4440325e4"}}</p>
  <input type="search" value="{{query}}" placeholder="{{localize "swade-better-effects.UI.Searchflags_8bcf6fb2eb"}}" aria-label="{{localize "swade-better-effects.UI.Searchflags_8bcf6fb2eb"}}" autocomplete="off">
  {{#if editable}}<div class="sbe-library-add"><input type="text" name="newFlags" value="{{newFlags}}" placeholder="{{localize "swade-better-effects.UI.Addflagsseparatedbycommas_7c606447f5"}}" aria-label="{{localize "swade-better-effects.UI.Newflags_1178b91076"}}"><button type="button" data-action="add"><i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "swade-better-effects.UI.Add_9fd728c66c"}}</button></div>{{/if}}
  <ol class="sbe-library-list plain" aria-label="{{localize "swade-better-effects.UI.Flaglibrary_944c5ba1fc"}}">
    {{#each flags}}<li data-library-flag="{{name}}"><span>{{name}}</span>{{#if builtIn}}<i class="fa-solid fa-lock" title="{{localize "swade-better-effects.UI.Builtinflag_7a0468c290"}}" aria-label="{{localize "swade-better-effects.UI.Builtinflag_7a0468c290"}}"></i>{{else}}{{#if ../editable}}<a role="button" tabindex="0" data-action="remove" data-flag="{{name}}" aria-label="Remove {{name}}" title="{{localize "swade-better-effects.UI.Removeflag_53bca4dfe3"}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></a>{{/if}}{{/if}}</li>{{/each}}
  </ol>
  <p class="sbe-library-empty hint" hidden>{{localize "swade-better-effects.UI.Nomatchingflags_6821cb2a08"}}</p>
  {{#if editable}}<footer class="form-footer"><button type="button" data-action="scan">{{localize "swade-better-effects.UI.Scanworldflags_867ff90661"}}</button><button type="submit"><i class="fa-solid fa-save"></i> {{localize "swade-better-effects.UI.Savelibrary_20fecb58b6"}}</button></footer>{{/if}}
</section>
