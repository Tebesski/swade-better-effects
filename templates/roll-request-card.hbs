<section class="sbe-request-card">
  <h3><i class="fa-solid fa-dice" inert></i> {{request.name}}</h3>
  {{#if lingering}}<p>{{lingering}}</p>{{/if}}
  {{#if application}}<p>{{application}}</p>{{/if}}
  <p>{{localize "swade-better-effects.UI.Targetnumber_ac80530e78"}} <strong>{{request.targetNumber}}</strong>{{#if request.penalty}} {{localize "swade-better-effects.UI.Penalty_d79ac1d438"}} <strong>{{request.penalty}}</strong>{{/if}}</p>
  {{#if request.modifier}}<p>{{localize "swade-better-effects.UI.Modifier_3c09fe5ba4"}} <strong>{{request.modifier}}</strong></p>{{/if}}
  {{#if opposing}}<p>{{localize "swade-better-effects.UI.Opposedby_4b66c4dcd6"}} {{opposing.name}} · {{opposing.trait}} · <a class="content-link" data-uuid="{{opposing.messageUuid}}">{{localize "swade-better-effects.UI.Roll_4464105f25"}} {{opposing.total}}</a></p>{{/if}}
  {{#if request.description}}<p class="sbe-request-description">{{request.description}}</p>{{/if}}
  <button type="button" class="sbe-request-roll">{{localize "swade-better-effects.UI.Roll_4464105f25"}} {{request.name}}</button>
  {{#if flags}}<details class="sbe-chat-flags"><summary>{{localize "swade-better-effects.UI.Flags_f38d9950af"}}</summary><p>{{flags}}</p></details>{{/if}}
</section>
