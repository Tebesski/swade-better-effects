<div class="sbe-outcome-effect" role="group" aria-label="{{localize "swade-better-effects.UI.Applyeffect_4b92049abb"}}">
  <strong>{{localize "swade-better-effects.UI.Applyeffect_4b92049abb"}}</strong>
  <input type="hidden" data-field="effect" value="{{effectUuid}}">
