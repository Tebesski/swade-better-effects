<details data-outcome="{{key}}">
  <summary>{{label}}{{#if raise}} {{localize "swade-better-effects.UI.atleast_91c929e462"}} {{threshold}}){{/if}}</summary>
  {{#if raise}}<label>{{localize "swade-better-effects.UI.Minimumraises_f85c65bb33"}} <input type="number" data-field="threshold" min="1" step="1" value="{{threshold}}"></label>{{/if}}
  <label>{{localize "swade-better-effects.UI.Progressgained_2c3a4a44e3"}} <input type="number" data-field="progress" min="0" step="1" value="{{progress}}"></label>
  <label>{{localize "swade-better-effects.UI.Damageformula_c6292464ab"}} <input type="text" data-field="damage" value="{{damage}}" placeholder="{{localize "swade-better-effects.UI.1d6x2_404b8324e4"}}"></label>
  <label>{{localize "swade-better-effects.UI.Chatmessage_f6820511a8"}} <textarea data-field="message" rows="2">{{message}}</textarea></label>
  <div class="sbe-outcome-effects">
    {{#each effects}}
      {{> "modules/swade-better-effects/templates/effect-reference.hbs" effectUuid=uuid lingering=true}}
    {{/each}}
    {{> "modules/swade-better-effects/templates/effect-reference.hbs" effectUuid="" lingering=true removeWithParent=true}}
  </div>
  {{#if optional}}<button type="button" data-remove-outcome>{{localize "swade-better-effects.UI.Removeoutcome_aafdfffea7"}}</button>{{/if}}
</details>
