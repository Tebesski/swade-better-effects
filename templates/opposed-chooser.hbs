<section class="standard-form">
  {{#if multiple}}<div class="form-group"><label for="{{rootId}}-target">Target</label><div class="form-fields"><select id="{{rootId}}-target" name="target" aria-label="Target">{{#each targets}}<option value="{{uuid}}" {{#if (eq uuid ../selected)}}selected{{/if}}>{{name}}</option>{{/each}}</select></div></div>{{else}}<strong>{{name}}</strong>{{/if}}
  <p class="sbe-opposed-summary">Opposed roll · TN <strong>{{tn}}</strong></p>
  <input type="search" value="{{query}}" placeholder="Search attributes and skills" aria-label="Search traits" autocomplete="off">
  <div class="sbe-trait-groups">
    <fieldset class="sbe-trait-group" data-trait-group="attributes"><legend>Attributes</legend>
      {{#each attributes}}<button type="button" class="sbe-trait-choice" data-action="choose" data-kind="attribute" data-trait="{{key}}" data-name="{{name}}"><span>{{name}}</span><span class="sbe-trait-die">{{die}}</span></button>{{/each}}
    </fieldset>
    <fieldset class="sbe-trait-group" data-trait-group="skills"><legend>Skills</legend>
      {{#each skills}}<button type="button" class="sbe-trait-choice" data-action="choose" data-kind="skill" data-trait="{{key}}" data-name="{{name}}"><span>{{name}}</span><span class="sbe-trait-die">{{die}}</span></button>{{/each}}
    </fieldset>
    <p class="hint sbe-no-traits" hidden>No matching traits.</p>
  </div>
</section>
